# Copy this file to ".env" and fill in the values. Restart the app after changes.

# Gmail account that SENDS the reminders
GMAIL_USER=

# 16-character Google App Password (Google Account → Security → 2-Step Verification → App passwords).
# Spaces are fine. Never share this value in chat or e-mail.
GMAIL_APP_PASSWORD=

# Optional
# Name of your own (default) workspace
ORG_NAME=My Firm
MAIL_FROM_NAME=Compliance Desk
PORT=4300
# URL included in reminder e-mails (change if you host the dashboard on a server / intranet)
APP_URL=http://localhost:4300
